# ---------------------------------------------------------------------------
# Network of Deeds by Kids (little-but-loud) - environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Server: database (required) -------------------------------------------
# MySQL connection string used by Drizzle ORM.
# Without this the server boots and serves the SPA, but every tRPC query that
# touches the database throws "Database not available", and the test suite fails.
DATABASE_URL=mysql://user:password@localhost:3306/little_but_loud

# --- Server: session signing (required) ------------------------------------
# Secret used to sign the session cookie (app_session_id).
JWT_SECRET=change-me-to-a-long-random-string

# --- Server: OAuth (required for admin sign-in) ----------------------------
# Backend base URL of the OAuth provider. The server logs an explicit
# "OAUTH_SERVER_URL is not configured" error at boot when this is missing.
OAUTH_SERVER_URL=https://oauth.example.com
# Open ID of the account treated as the application owner / admin.
OWNER_OPEN_ID=

# --- Server: object storage proxy (required for images and file uploads) ---
# GET /manus-storage/* presigns against this backend. Member photos, event
# cover images and resource files all resolve through it; without these two
# values every image on the site returns 500 and uploads fail.
BUILT_IN_FORGE_API_URL=https://forge.example.com
BUILT_IN_FORGE_API_KEY=

# --- Server: transactional email (optional) --------------------------------
# SendGrid key for connection-request, event-signup and account emails.
# When unset the server logs "SendGrid API key not configured" and skips sends.
SENDGRID_API_KEY=

# --- Server: runtime -------------------------------------------------------
# Preferred port. The server scans upward for a free port if this one is busy.
PORT=3000

# --- Client (Vite, baked in at build time) ---------------------------------
# VITE_OAUTH_PORTAL_URL is required: getLoginUrl() calls new URL() on it, so an
# empty value throws "TypeError: Invalid URL" and the whole SPA renders the
# error boundary instead of the site.
VITE_OAUTH_PORTAL_URL=https://oauth.example.com
VITE_APP_ID=little-but-loud
VITE_FRONTEND_FORGE_API_URL=https://forge.example.com
VITE_FRONTEND_FORGE_API_KEY=

# --- Client: analytics (optional) ------------------------------------------
# Substituted into client/index.html at build time. Left unset, Vite prints a
# harmless "not defined in env variables" warning during the build.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- Local helper scripts only ---------------------------------------------
# Used by check-email.mjs, which connects to a local MySQL as root.
MYSQL_ROOT_PASSWORD=
